      "relatedExpressions": ["caramba", "meu Deus"],
      "usageNotes": ["语气友好，不会冒犯别人。"],
      "difficulty": "A2",
      "tags": ["口语", "情感"]
    },
    {
      "headword": "sei lá",
      "type": "expression",
      "partOfSpeech": "expressão",
      "translations": ["不知道", "说不准"],
      "meanings": [{ "definition": "表示不确定或不在乎", "note": "语气比较随意" }],
      "patterns": ["sei lá", "sei lá, né"],
      "collocations": ["sei lá, cara"],
      "examples": [
        { "sourceText": "— Você acha que vai chover? — Sei lá.", "translation": "——你觉得会下雨吗？——不知道啊。", "note": "" },
        { "sourceText": "Sei lá, talvez seja melhor esperar.", "translation": "说不准，也许等一等更好。", "note": "" }
