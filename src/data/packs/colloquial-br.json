      "relatedExpressions": ["não sei", "talvez"],
      "usageNotes": ["对老板说可能显得敷衍，正式场合用 não sei ao certo。"],
      "difficulty": "B1",
      "tags": ["口语", "俚语"]
    },
    {
      "headword": "deixa quieto",
      "type": "expression",
      "partOfSpeech": "expressão",
      "translations": ["算了", "别管了"],
