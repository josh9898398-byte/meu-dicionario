  "entries": [
    {
      "headword": "beleza",
      "type": "expression",
      "partOfSpeech": "interjeição",
      "translations": ["好", "行", "没问题"],
      "meanings": [{ "definition": "表示同意或确认", "note": "巴西最常用的口头确认之一" }],
      "patterns": ["beleza?", "beleza!", "beleza então"],
      "collocations": ["beleza, combinado", "tá beleza"],
      "examples": [
        { "sourceText": "— Te vejo às oito. — Beleza!", "translation": "——八点见。——好！", "note": "回答约定" },
        { "sourceText": "Beleza, então a gente se fala depois.", "translation": "行，那我们之后再联系。", "note": "结束对话常用" }
      ],
      "relatedExpressions": ["combinado", "tranquilo", "fechado"],
      "usageNotes": ["也可以表示“漂亮”，但对话里几乎都是“行、好”。"],
      "difficulty": "A2",
      "tags": ["口语", "俚语"]
    },
    {
      "headword": "valeu",
      "type": "expression",
      "partOfSpeech": "interjeição",
      "translations": ["谢谢", "辛苦了"],
      "meanings": [{ "definition": "随意的感谢", "note": "来自 valer，含“值了、够意思”" }],
      "patterns": ["valeu!", "valeu, viu", "valeu mesmo"],
      "collocations": ["valeu, cara", "valeu pela ajuda"],
      "examples": [
        { "sourceText": "Valeu pela ajuda, viu!", "translation": "谢谢你的帮忙啊！", "note": "结尾 viu 让语气更亲切" },
        { "sourceText": "Valeu, a gente se vê amanhã.", "translation": "谢啦，明天见。", "note": "" }
      ],
      "relatedExpressions": ["obrigado", "valeu a pena"],
      "usageNotes": ["对长辈或客户用 obrigado 更稳妥。"],
      "difficulty": "A2",
      "tags": ["口语", "社交"]
    },
    {
      "headword": "pois é",
      "type": "expression",
      "partOfSpeech": "interjeição",
      "translations": ["是啊", "就是说嘛"],
      "meanings": [{ "definition": "表示认同、附和", "note": "常带一点无奈或感慨" }],
      "patterns": ["pois é", "pois é, né?"],
      "collocations": ["pois é, complicado"],
      "examples": [
        { "sourceText": "— O trânsito está horrível. — Pois é.", "translation": "——交通太糟了。——是啊。", "note": "附和对方" },
        { "sourceText": "Pois é, as coisas mudaram muito.", "translation": "就是说嘛，情况变了很多。", "note": "" }
      ],
      "relatedExpressions": ["né", "é isso aí"],
      "usageNotes": ["说 pois é 时通常配合点头，语气自然。"],
      "difficulty": "A2",
      "tags": ["口语", "对话"]
    },
    {
      "headword": "né",
      "type": "expression",
      "partOfSpeech": "interjeição",
      "translations": ["对吧", "是不是"],
      "meanings": [{ "definition": "确认对方意见的附加问句", "note": "não é 的口语缩写" }],
      "patterns": ["né?", "né, cara"],
      "collocations": ["legal, né", "difícil, né"],
      "examples": [
        { "sourceText": "Esse filme é ótimo, né?", "translation": "这电影很棒，对吧？", "note": "几乎每段对话都会出现" },
        { "sourceText": "Né, eu também acho.", "translation": "对吧，我也这么觉得。", "note": "" }
      ],
      "relatedExpressions": ["não é", "pois é"],
      "usageNotes": ["口语中非常频繁，正式书面文本里不要用。"],
      "difficulty": "A2",
      "tags": ["口语", "对话"]
    },
    {
      "headword": "tipo assim",
      "type": "expression",
      "partOfSpeech": "expressão",
      "translations": ["就像这样", "那个……"],
      "meanings": [{ "definition": "填充语，用来组织语言", "note": "年轻人常用" }],
      "patterns": ["tipo assim, ...", "tipo"],
      "collocations": ["tipo assim, sabe"],
      "examples": [
        { "sourceText": "Tipo assim, eu não concordo totalmente.", "translation": "怎么说呢，我不完全同意。", "note": "让语气更委婉" },
        { "sourceText": "Ele é tipo assim, muito organizado.", "translation": "他算是……非常有条理的那种。", "note": "" }
      ],
      "relatedExpressions": ["sabe", "entendeu"],
      "usageNotes": ["相当于中文的“就是那种感觉”，正式场合避免。"],
      "difficulty": "B1",
      "tags": ["口语", "俚语"]
    },
    {
