      "patterns": ["nossa!", "nossa, sério?"],
      "collocations": ["nossa senhora", "nossa, que legal"],
      "examples": [
        { "sourceText": "Nossa, que notícia boa!", "translation": "哇，好消息啊！", "note": "表示惊喜" },
        { "sourceText": "Nossa, isso é muito caro.", "translation": "天哪，这太贵了。", "note": "" }
