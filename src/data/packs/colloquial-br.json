      "relatedExpressions": ["deixa pra lá", "esquece"],
      "usageNotes": ["说 deixa pra lá 有时暗示不想再谈了。"],
      "difficulty": "B1",
      "tags": ["口语", "对话"]
    },
    {
      "headword": "tô nem aí",
      "type": "expression",
      "partOfSpeech": "expressão",
      "translations": ["我不在乎", "无所谓"],
      "meanings": [{ "definition": "表示完全不关心", "note": "tô = estou" }],
      "patterns": ["tô nem aí", "não estou nem aí"],
      "collocations": ["tô nem aí pra isso"],
      "examples": [
        { "sourceText": "Tô nem aí pro que eles pensam.", "translation": "他们怎么想我一点都不在乎。", "note": "年轻人口语，语气较随意" },
        { "sourceText": "Ela não está nem aí para o prazo.", "translation": "她根本不管截止时间。", "note": "" }
