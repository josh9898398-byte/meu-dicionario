      "patterns": ["deixa quieto", "deixa pra lá"],
      "collocations": ["deixa quieto, esquece"],
      "examples": [
        { "sourceText": "Deixa quieto, não vale a pena discutir.", "translation": "算了，不值得争。", "note": "" },
        { "sourceText": "— E o problema? — Deixa pra lá.", "translation": "——那问题呢？——算了吧。", "note": "deixa pra lá 更口语" }
