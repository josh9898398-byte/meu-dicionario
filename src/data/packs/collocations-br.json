    {
      "headword": "tomar uma decisão",
      "type": "phrase",
      "partOfSpeech": "locução verbal",
      "translations": ["做决定"],
      "meanings": [{ "definition": "做出决定", "note": "动词搭配用 tomar，不用 fazer" }],
      "patterns": ["tomar uma decisão", "tomar a decisão de fazer"],
      "collocations": ["tomar uma decisão difícil"],
      "examples": [
        { "sourceText": "Precisamos tomar uma decisão até amanhã.", "translation": "我们得在明天前做决定。", "note": "" },
        { "sourceText": "Ele tomou a decisão de mudar de cidade.", "translation": "他决定了要换城市。", "note": "" }
      ],
      "relatedExpressions": ["decidir", "escolher"],
      "usageNotes": ["tomar uma decisão 比 decidir 更有分量、更书面。"],
      "difficulty": "B1",
      "tags": ["工作", "搭配"]
    },
    {
